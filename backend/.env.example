# One of: openai, deepseek, gemini, ollama, openrouter, anthropic, openai_compatible
LLM_PROVIDER=deepseek
LLM_API_KEY=your-key          # not needed for ollama
# LLM_MODEL=                  # optional override; each provider has a default
# LLM_BASE_URL=               # optional; required for openai_compatible
# LLM_CRITIC_MODEL=           # optional; model for the critic agent (default: LLM_MODEL)
# HARNESS_CRITIC_ROUNDS=1     # critic-driven revisions; 0 = review only, -1 = no critic
# HARNESS_CLARIFY=1           # ask questions first when a new-diagram request is vague; 0 = never
# HARNESS_CLARIFY_MAX_WORDS=25  # requests this long or longer skip the clarifier
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
