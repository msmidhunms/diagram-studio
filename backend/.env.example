# One of: openai, deepseek, gemini, ollama, openrouter, anthropic, openai_compatible
LLM_PROVIDER=deepseek
LLM_API_KEY=your-key          # not needed for ollama
# LLM_MODEL=                  # optional override; each provider has a default
# LLM_BASE_URL=               # optional; required for openai_compatible
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
