# One of: openai, deepseek, gemini, ollama, openrouter, anthropic, openai_compatible
LLM_PROVIDER=deepseek
LLM_API_KEY=your-key          # not needed for ollama
# LLM_MODEL=                  # optional override; each provider has a default
# LLM_BASE_URL=               # optional; required for openai_compatible
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Song studio (optional). ElevenLabs enables AI-sung vocals and native-sounding speech.
# ELEVENLABS_API_KEY=
# TTS_PROVIDER=elevenlabs     # or openai (uses OPENAI_API_KEY); empty = browser voices
# OPENAI_API_KEY=
