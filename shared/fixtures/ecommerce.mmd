flowchart LR
  n_stripe[/"Stripe payments"/]
  subgraph g_pub["Public internet"]
    n_user(["Customer"])
    n_spa(["Storefront SPA<br/>React"])
  end
  subgraph g_vpc["AWS VPC (private)"]
    n_gw[/"API Gateway"\]
    n_orders["Orders service<br/>Django 5"]
    n_events[["Order events<br/>Kafka"]]
    n_mailer("Email worker")
    subgraph g_data["Data tier"]
      n_cache{{"Session & cart cache<br/>Redis"}}
      n_db[("Orders DB<br/>PostgreSQL 16")]
      n_replica[("Read replica")]
    end
  end
  n_user --> n_spa
  n_spa -->|"HTTPS"| n_gw
  n_gw --> n_orders
  n_orders --> n_cache
  n_orders -->|"SQL"| n_db
  n_db ==>|"replication"| n_replica
  n_orders -.->|"order.created"| n_events
  n_events -.-> n_mailer
  n_orders -->|"charge"| n_stripe
  classDef database fill:#e8f1fb,stroke:#3b6ea5
  classDef cache fill:#fdf1e3,stroke:#c07a2c
  classDef queue fill:#f3ecfa,stroke:#7d55a8
  classDef external fill:#f2f2f2,stroke:#777,stroke-dasharray:4 3
  classDef client fill:#eaf6ee,stroke:#3f8a57
  classDef user fill:#eaf6ee,stroke:#3f8a57
  class n_user user
  class n_spa client
  class n_events queue
  class n_cache cache
  class n_db database
  class n_replica database
  class n_stripe external
  style g_pub fill:transparent,stroke:#c0392b,stroke-width:2px,stroke-dasharray:6 4
  style g_vpc fill:transparent,stroke:#c0392b,stroke-width:2px,stroke-dasharray:6 4
